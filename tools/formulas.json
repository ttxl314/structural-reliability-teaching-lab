[
  { "id": "pf_def", "tex": "P_f = P[g(X)\\le 0] = \\int_{g(x)\\le 0} f_X(x)\\,dx" },
  { "id": "pf_beta", "tex": "P_f = \\Phi(-\\beta) \\qquad \\beta = -\\Phi^{-1}(P_f)" },
  { "id": "trans_x", "tex": "X \\sim N(\\mu_X,\\,C_X)" },
  { "id": "trans_center", "tex": "Y = X - \\mu_X" },
  { "id": "trans_scale", "tex": "Z = D^{-1}Y,\\qquad D=\\mathrm{diag}(\\sigma_1,\\sigma_2)" },
  { "id": "trans_whiten", "tex": "U = L^{-1}(X-\\mu_X),\\qquad LL^{T}=C_X" },
  { "id": "pca", "tex": "X=\\mu_X+Q\\Lambda^{1/2}U,\\qquad Q\\Lambda Q^{T}=C_X" },
  { "id": "ellipse", "tex": "(x-\\mu_X)^{T}C_X^{-1}(x-\\mu_X)=\\beta^{2}" },
  { "id": "mvfosm_lin", "tex": "g(X)\\approx g(\\mu_X)+\\nabla g(\\mu_X)^{T}(X-\\mu_X)" },
  { "id": "mvfosm_moments", "tex": "\\mu_g\\approx g(\\mu_X),\\qquad \\sigma_g^{2}\\approx\\nabla g^{T}C_X\\nabla g" },
  { "id": "mvfosm_beta", "tex": "\\beta_M=\\frac{\\mu_g}{\\sigma_g},\\qquad P_f\\approx\\Phi(-\\beta_M)" },
  { "id": "afosm_dir", "tex": "\\alpha=-\\frac{L^{T}\\nabla g(x)}{\\|L^{T}\\nabla g(x)\\|},\\qquad x=\\mu_X+\\beta L\\alpha" },
  { "id": "afosm_beta", "tex": "g(\\mu_X+\\beta L\\alpha)=0\\ \\Longrightarrow\\ \\beta" },
  { "id": "form_beta", "tex": "\\beta=\\min\\{\\|u\\|:\\ g(u)=0\\}" },
  { "id": "form_alpha", "tex": "\\alpha=-\\frac{\\nabla g(u^{*})}{\\|\\nabla g(u^{*})\\|},\\qquad u^{*}=\\beta\\alpha" },
  { "id": "hlrf", "tex": "u_{k+1}=\\frac{\\nabla g(u_k)^{T}u_k-g(u_k)}{\\|\\nabla g(u_k)\\|^{2}}\\,\\nabla g(u_k)" },
  { "id": "form_xstar", "tex": "x^{*}=\\mu_X+L u^{*}" },
  { "id": "form_pf", "tex": "P_f\\approx\\Phi(-\\beta)" },
  { "id": "sensitivity", "tex": "\\frac{\\partial\\beta}{\\partial\\mu_X}=\\frac{\\nabla g(x^{*})}{\\|L^{T}\\nabla g(x^{*})\\|}" },
  { "id": "sorm", "tex": "P_f\\approx\\Phi(-\\beta)\\prod_{i=1}^{n-1}(1+\\beta\\kappa_i)^{-1/2}" },
  { "id": "sorm_n2", "tex": "P_f\\approx\\frac{\\Phi(-\\beta)}{\\sqrt{1+\\beta\\kappa}}" },
  { "id": "mc", "tex": "P_f\\approx\\frac{1}{N}\\sum_{j=1}^{N}I[g(x_j)\\le 0]" },
  { "id": "mc_cov", "tex": "\\mathrm{COV}=\\sqrt{\\frac{1-P_f}{NP_f}},\\qquad se=\\sqrt{\\frac{P_f(1-P_f)}{N}}" },
  { "id": "interference", "tex": "P_f=\\int f_S(s)F_R(s)\\,ds" }
]
